  "_panduan_implementasi": {
    "cara_baca_frames": "Index frame dihitung linear kiri-ke-kanan, baris-per-baris dari sprite sheet. Frame 0 = pojok kiri atas.",
    "cara_hitung_posisi": "x = (frame_index % kolom_per_baris) * frame_lebar, y = Math.floor(frame_index / kolom_per_baris) * frame_tinggi",
    "flip_horizontal": "Gunakan ctx.scale(-1, 1) sebelum drawImage untuk karakter menghadap kanan. Jangan buat sprite terpisah.",
    "iframes": "Saat hurt, karakter tidak bisa terkena damage selama iframes_durasi_ms. Implementasi via flag isInvincible.",
    "hitbox_aktif": "Hitbox serangan HANYA aktif di frame index yang disebutkan di hitbox_aktif_frame. Di luar frame itu, hitbox tidak ada.",
    "auto_destroy_vfx": "Semua VFX dengan loop:false dan next:null harus dihapus dari scene setelah animasi selesai."
